# Variáveis do serviço de API PIX — configure valores secretos apenas no Railway.
# Não reutilize valores que já tenham sido publicados no histórico do repositório.

# Autenticação RecargaPay (segredos configurados no ambiente do serviço)
BEARER_TOKEN=
RECARGA_REFRESH_TOKEN=
BEARER_EXPIRES=

# Conta/dispositivo
USER_ID=
CLIENT_ID=
DEVICE_ID=
DEVICE_UUID=
DEVICE_INSTID=
ADVERTISING_ID=

# Credenciais de pagamento — nunca versionar valores reais
PIN_CODE=
PIN_MODE=biometric
PIX_HMAC_SECRET=
PIX_API_TOKEN=

# Renovação OAuth/Firebase
GOOGLE_CLIENT_ID=
GOOGLE_REFRESH_TOKEN=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIS_FID=
FIS_REFRESH_TOKEN=

# Destinatário padrão e geolocalização
RECEIVER_PERSON_ID=
RECEIVER_ACCOUNT_ID=
GEO_LAT=
GEO_LON=

# Outros valores operacionais
COOKIE_AB1=
HID=
PIX_DEFAULT_DESCRIPTION=
